{
  "name": "crispy_print",
  "private": true,
  "description": "Typst-based print format builder for Frappe",
  "scripts": {
    "postinstall": "cd crispy_print/public/js && yarn install --check-files",
    "lint": "eslint \"crispy_print/public/js/**/*.{js,ts,vue}\" --quiet",
    "test:unit": "cd crispy_print/public/js && yarn test:unit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.26.0",
    "prettier": "^3.3.0",
    "typescript": "^5.3.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "yarn": ">=1.22.0"
  }
}
