msgid "1 field selected"
msgstr "已选择 1 个字段"

#. Content of the 'Typst Help' (HTML) field in DocType 'Crispy Format'
#: crispy_print/crispy_print/doctype/crispy_format/crispy_format.json
msgid ""
"<div style=\"line-height:1.5;\">\n"
"  <h4 style=\"margin:0 0 10px;\">Typst Help</h4>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>How Styling Works</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>\n"
"        In normal builder mode, <code>fieldLabelStyle</code>, <code>fieldValueStyle</code>, and <code>sectionLabelStyle</code> are configured in the Builder and automatically inserted before <code>typst_preamble</code>.\n"
"      </li>\n"
"      <li>\n"
"        <code>typst_preamble</code> runs before document content and can override global styles.\n"
"      </li>\n"
"      <li>\n"
"        <code>doc_header</code> defines <code>header_block</code>, and <code>doc_footer</code> defines <code>footer_block</code> for page header/footer setup.\n"
"      </li>\n"
"      <li>\n"
"        In Raw Typst mode, Crispy only injects document data and helper functions. Page setup, styling, header, footer, and layout belong in the Raw Typst code.\n"
"      </li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Raw Typst Helpers</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Document data is available as <code>#doc.fieldname</code>.</li>\n"
"      <li>Use <code>crispy_image(\"logo.svg\", width: 20mm)</code> and <code>crispy_block(\"document_title-v1.0\")</code> inside function arguments or other Typst expression contexts.</li>\n"
"      <li>When calling a helper directly from markup, add Typst's markup escape: <code>#crispy_image(\"logo.svg\", width: 20mm)</code> or <code>#crispy_block(\"document_title-v1.0\")</code>.</li>\n"
"      <li><code>crispy_image</code> resolves plain filenames only from the current site's private files assets.</li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Quick Examples</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Preamble: <code>#set text(font: \"Inter\", size: 11pt)</code></li>\n"
"      <li>Header: <code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n"
"      <li>Footer: <code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n"
"      <li>Raw placement: <code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div>\n"
"    <strong>Branding Layers</strong>\n"
"    <div style=\"margin-top:4px;\">\n"
"      In normal builder mode, the letterhead is rendered in the page <code>background</code>, while the logo and QR code are rendered in the <code>foreground</code> layer.\n"
"    </div>\n"
"  </div>\n"
"</div>"
msgstr ""
"<div style=\"line-height:1.5;\">\n"
"  <h4 style=\"margin:0 0 10px;\">Typst 帮助</h4>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>样式如何工作</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>\n"
"        在普通构建器模式下，<code>fieldLabelStyle</code>、<code>fieldValueStyle</code> 和 <code>sectionLabelStyle</code> 在构建器中配置，并自动插入到 <code>typst_preamble</code> 之前。\n"
"      </li>\n"
"      <li>\n"
"        <code>typst_preamble</code> 在文档内容之前运行，并且可以覆盖全局样式。\n"
"      </li>\n"
"      <li>\n"
"        <code>doc_header</code> 定义 <code>header_block</code>，<code>doc_footer</code> 定义用于页面页眉/页脚设置的 <code>footer_block</code>。\n"
"      </li>\n"
"      <li>\n"
"        在 Raw Typst 模式下，Crispy 仅注入文档数据和辅助函数。页面设置、样式、页眉、页脚和布局属于原始 Typst 代码。\n"
"      </li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>原始 Typst 辅助函数</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>文档数据以 <code>#doc.fieldname</code> 形式提供。</li>\n"
"      <li>在函数参数或其他 Typst 表达式上下文中使用 <code>crispy_image(\"logo.svg\", width: 20mm)</code> 和 <code>crispy_block(\"document_title-v1.0\")</code>。</li>\n"
"      <li>直接从标记调用助手时，请添加 Typst 的标记转义：<code>#crispy_image(\"logo.svg\", width: 20mm)</code> 或 <code>#crispy_block(\"document_title-v1.0\")</code>。</li>\n"
"      <li><code>crispy_image</code> 仅解析当前网站的私有文件资源中的纯文件名。</li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>简单示例</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>序言：<code>#set text(font: \"Inter\", size: 11pt)</code></li>\n"
"      <li>标题：<code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n"
"      <li>页脚：<code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n"
"      <li>原始位置：<code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div>\n"
"    <strong>品牌层</strong>\n"
"    <div style=\"margin-top:4px;\">\n"
"      在正常构建器模式下，信头在页面 <code>background</code> 中渲染，而徽标和 QR 码在 <code>foreground</code> 层中渲染。\n"
"    </div>\n"
"  </div>\n"
"</div>"

