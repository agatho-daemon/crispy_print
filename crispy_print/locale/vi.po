#: crispy_print/public/js/components/SettingsPane.vue:1266
msgid "1 field selected"
msgstr "Đã chọn 1 trường"

#. Content of the 'Typst Help' (HTML) field in DocType 'Crispy Format'
#: crispy_print/crispy_print/doctype/crispy_format/crispy_format.json
msgid ""
"<div style=\"line-height:1.5;\">\n"
"  <h4 style=\"margin:0 0 10px;\">Typst Help</h4>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>How Styling Works</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>\n"
"        In normal builder mode, <code>fieldLabelStyle</code>, <code>fieldValueStyle</code>, and <code>sectionLabelStyle</code> are configured in the Builder and automatically inserted before <code>typst_preamble</code>.\n"
"      </li>\n"
"      <li>\n"
"        <code>typst_preamble</code> runs before document content and can override global styles.\n"
"      </li>\n"
"      <li>\n"
"        <code>doc_header</code> defines <code>header_block</code>, and <code>doc_footer</code> defines <code>footer_block</code> for page header/footer setup.\n"
"      </li>\n"
"      <li>\n"
"        In Raw Typst mode, Crispy only injects document data and helper functions. Page setup, styling, header, footer, and layout belong in the Raw Typst code.\n"
"      </li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Raw Typst Helpers</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Document data is available as <code>#doc.fieldname</code>.</li>\n"
"      <li>Use <code>crispy_image(\"logo.svg\", width: 20mm)</code> and <code>crispy_block(\"document_title-v1.0\")</code> inside function arguments or other Typst expression contexts.</li>\n"
"      <li>When calling a helper directly from markup, add Typst's markup escape: <code>#crispy_image(\"logo.svg\", width: 20mm)</code> or <code>#crispy_block(\"document_title-v1.0\")</code>.</li>\n"
"      <li><code>crispy_image</code> resolves plain filenames only from the current site's private files assets.</li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Quick Examples</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Preamble: <code>#set text(font: \"Inter\", size: 11pt)</code></li>\n"
"      <li>Header: <code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n"
"      <li>Footer: <code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n"
"      <li>Raw placement: <code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div>\n"
"    <strong>Branding Layers</strong>\n"
"    <div style=\"margin-top:4px;\">\n"
"      In normal builder mode, the letterhead is rendered in the page <code>background</code>, while the logo and QR code are rendered in the <code>foreground</code> layer.\n"
"    </div>\n"
"  </div>\n"
"</div>"
msgstr ""
"<div style=\"line-height:1.5;\">\n"
"  <h4 style=\"margin:0 0 10px;\">Typst Help</h4>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>How Styling Works</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>\n"
"        In normal builder mode, <code>fieldLabelStyle</code>, <code>fieldValueStyle</code>, and <code>sectionLabelStyle</code> are configured in the Builder and automatically inserted before <code>typst_preamble</code>.\n"
"      </li>\n"
"      <li>\n"
"        <code>typst_preamble</code> runs before document content and can override global styles.\n"
"      </li>\n"
"      <li>\n"
"        <code>doc_header</code> defines <code>header_block</code>, and <code>doc_footer</code> defines <code>footer_block</code> for page header/footer setup.\n"
"      </li>\n"
"      <li>\n"
"        In Raw Typst mode, Crispy only injects document data and helper functions. Page setup, styling, header, footer, and layout belong in the Raw Typst code.\n"
"      </li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Raw Typst Helpers</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Document data is available as <code>#doc.fieldname</code>.</li>\n"
"      <li>Use <code>crispy_image(\"logo.svg\", width: 20mm)</code> and <code>crispy_block(\"document_title-v1.0\")</code> inside function arguments or other Typst expression contexts.</li>\n"
"      <li>When calling a helper directly from markup, add Typst's markup escape: <code>#crispy_image(\"logo.svg\", width: 20mm)</code> or <code>#crispy_block(\"document_title-v1.0\")</code>.</li>\n"
"      <li><code>crispy_image</code> resolves plain filenames only from the current site's private files assets.</li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Quick Examples</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Preamble: <code>#set text(font: \"Inter\", size: 11pt)</code></li>\n"
"      <li>Header: <code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n"
"      <li>Footer: <code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n"
"      <li>Raw placement: <code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div>\n"
"    <strong>Branding Layers</strong>\n"
"    <div style=\"margin-top:4px;\">\n"
"      In normal builder mode, the letterhead is rendered in the page <code>background</code>, while the logo and QR code are rendered in the <code>foreground</code> layer.\n"
"    </div>\n"
"  </div>\n"
"</div><div style=\"line-height:1.5;\">\n"
"  <h4 style=\"margin:0 0 10px;\">Trợ giúp Typst</h4>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Cách tạo kiểu hoạt động</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; đệm:0;\">\n"
"      <li>\n"
"        Ở chế độ trình tạo thông thường, <code>fieldLabelStyle</code>, <code>fieldValueStyle</code> và <code>sectionLabelStyle</code> được định cấu hình trong Trình tạo và tự động được chèn trước <code>typst_preamble</code>.\n"
"      </li>\n"
"      <li>\n"
"        <code>typst_preamble</code> chạy trước nội dung tài liệu và có thể ghi đè các kiểu chung.\n"
"      </li>\n"
"      <li>\n"
"        <code>doc_header</code> xác định <code>header_block</code> và <code>doc_footer</code> xác định <code>footer_block</code> để thiết lập đầu trang/chân trang.\n"
"      </li>\n"
"      <li>\n"
"        Ở chế độ Raw Typst, Crispy chỉ đưa dữ liệu tài liệu và các chức năng trợ giúp vào. Thiết lập trang, kiểu dáng, đầu trang, chân trang và bố cục thuộc về mã Typst thô.\n"
"      </li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Người trợ giúp Typst thô</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; đệm:0;\">\n"
"      <li>Dữ liệu tài liệu có sẵn dưới dạng <code>#doc.fieldname</code>.</li>\n"
"      <li>Sử dụng <code>crispy_image(\"logo.svg\", width: 20mm)</code> và <code>crispy_block(\"document_title-v1.0\")</code> bên trong các đối số hàm hoặc các ngữ cảnh biểu thức Typst khác.</li>\n"
"      <li>Khi gọi trực tiếp người trợ giúp từ đánh dấu, hãy thêm lối thoát đánh dấu của Typst: <code>#crispy_image(\"logo.svg\", width: 20mm)</code> hoặc <code>#crispy_block(\"document_title-v1.0\")</code>.</li>\n"
"      <li><code>crispy_image</code> chỉ phân giải tên tệp đơn giản từ nội dung tệp riêng tư của trang web hiện tại.</li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Ví dụ nhanh</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; đệm:0;\">\n"
"      <li>Lời mở đầu: <code>#set text(font: \"Inter\", size: 11pt)</code></li>\n"
"      <li>Tiêu đề: <code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n"
"      <li>Chân trang: <code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n"
"      <li>Vị trí thô: <code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div>\n"
"    <strong>Lớp xây dựng thương hiệu</strong>\n"
"    <div style=\"margin-top:4px;\">\n"
"      Ở chế độ trình tạo thông thường, tiêu đề thư được hiển thị trong trang <code>background</code>, trong khi logo và mã QR được hiển thị trong lớp <code>foreground</code>.\n"
"    </div>\n"
"  </div>\n"
"</div>"

