msgid ""
"PDF output standard:\n"
"<ul>\n"
"  <li>PDF/A-2u for normal business archives</li>\n"
"  <li>PDF/A-3u when embedding machine-readable payloads such as XML or JSON</li>\n"
"  <li>PDF 1.7 for non-archival output (Typst default)</li>\n"
"  <li>PDF 2.0 for modern non-archival output where supported</li>\n"
"  <li>PDF/A-4 where accepted by the relevant authority</li>\n"
"</ul>\n"
"<span style=\"color: var(--orange-600);\">\n"
"  Note: PDF/A output embeds fonts, so selected fonts must permit PDF embedding/subsetting.\n"
"</span>"
msgstr ""
"Standard di uscita PDF:\n"
"<ul>\n"
"  <li>PDF/A-2u per normali archivi aziendali</li>\n"
"  <li>PDF/A-3u quando si incorporano payload leggibili dalla macchina come XML o JSON</li>\n"
"  <li>PDF 1.7 per output non di archivio (impostazione predefinita Typst)</li>\n"
"  <li>PDF 2.0 per output moderno non di archiviazione, ove supportato</li>\n"
"  <li>PDF/A-4 ove accettato dall'autorità competente</li>\n"
"</ul>\n"
"<span style=\"color: var(--orange-600);\">\n"
"  Nota: l'output PDF/A incorpora i caratteri, quindi i caratteri selezionati devono consentire l'incorporamento/sottoimpostazione PDF.\n"
"</span>"

