#: crispy_print/public/js/components/SettingsPane.vue:1159
msgid "1 field selected"
msgstr "เลือกแล้ว 1 ช่อง"

#. Content of the 'Typst Help' (HTML) field in DocType 'Crispy Format'
#: crispy_print/crispy_print/doctype/crispy_format/crispy_format.json
msgid ""
"<div style=\"line-height:1.5;\">\n"
"  <h4 style=\"margin:0 0 10px;\">Typst Help</h4>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>How Styling Works</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>\n"
"        In normal builder mode, <code>fieldLabelStyle</code>, <code>fieldValueStyle</code>, and <code>sectionLabelStyle</code> are configured in the Builder and automatically inserted before <code>typst_preamble</code>.\n"
"      </li>\n"
"      <li>\n"
"        <code>typst_preamble</code> runs before document content and can override global styles.\n"
"      </li>\n"
"      <li>\n"
"        <code>doc_header</code> defines <code>header_block</code>, and <code>doc_footer</code> defines <code>footer_block</code> for page header/footer setup.\n"
"      </li>\n"
"      <li>\n"
"        In Raw Typst mode, Crispy only injects document data and helper functions. Page setup, styling, header, footer, and layout belong in the Raw Typst code.\n"
"      </li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Raw Typst Helpers</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Document data is available as <code>#doc.fieldname</code>.</li>\n"
"      <li>Use <code>crispy_image(\"logo.svg\", width: 20mm)</code> and <code>crispy_block(\"document_title-v1.0\")</code> inside function arguments or other Typst expression contexts.</li>\n"
"      <li>When calling a helper directly from markup, add Typst's markup escape: <code>#crispy_image(\"logo.svg\", width: 20mm)</code> or <code>#crispy_block(\"document_title-v1.0\")</code>.</li>\n"
"      <li><code>crispy_image</code> resolves plain filenames only from the current site's private files assets.</li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Quick Examples</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Preamble: <code>#set text(font: \"Inter\", size: 11pt)</code></li>\n"
"      <li>Header: <code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n"
"      <li>Footer: <code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n"
"      <li>Raw placement: <code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div>\n"
"    <strong>Branding Layers</strong>\n"
"    <div style=\"margin-top:4px;\">\n"
"      In normal builder mode, the letterhead is rendered in the page <code>background</code>, while the logo and QR code are rendered in the <code>foreground</code> layer.\n"
"    </div>\n"
"  </div>\n"
"</div>"
msgstr "<div style=\"line-height:1.5;\">\n  <h4 style=\"margin:0 0 10px;\">Typst Help</h4>\n\n  <div style=\"margin-bottom:14px;\">\n    <strong>How Styling Works</strong>\n    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n      <li>\n        In normal builder mode, <code>fieldLabelStyle</code>, <code>fieldValueStyle</code>, and <code>sectionLabelStyle</code> are configured in the Builder and automatically inserted before <code>typst_preamble</code>.\n      </li>\n      <li>\n        <code>typst_preamble</code> runs before document content and can override global styles.\n      </li>\n      <li>\n        <code>doc_header</code> defines <code>header_block</code>, and <code>doc_footer</code> defines <code>footer_block</code> for page header/footer setup.\n      </li>\n      <li>\n        In Raw Typst mode, Crispy only injects document data and helper functions. Page setup, styling, header, footer, and layout belong in the Raw Typst code.\n      </li>\n    </ol>\n  </div>\n\n  <div style=\"margin-bottom:14px;\">\n    <strong>Raw Typst Helpers</strong>\n    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n      <li>Document data is available as <code>#doc.fieldname</code>.</li>\n      <li>Use <code>crispy_image(\"logo.svg\", width: 20mm)</code> and <code>crispy_block(\"document_title-v1.0\")</code> inside function arguments or other Typst expression contexts.</li>\n      <li>When calling a helper directly from markup, add Typst's markup escape: <code>#crispy_image(\"logo.svg\", width: 20mm)</code> or <code>#crispy_block(\"document_title-v1.0\")</code>.</li>\n      <li><code>crispy_image</code> resolves plain filenames only from the current site's private files assets.</li>\n    </ol>\n  </div>\n\n  <div style=\"margin-bottom:14px;\">\n    <strong>Quick Examples</strong>\n    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n      <li>Preamble: <code>#set text(font: \"Inter\", size: 11pt)</code></li>\n      <li>Header: <code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n      <li>Footer: <code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n      <li>Raw placement: <code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n    </ol>\n  </div>\n\n  <div>\n    <strong>Branding Layers</strong>\n    <div style=\"margin-top:4px;\">\n      In normal builder mode, the letterhead is rendered in the page <code>background</code>, while the logo and QR code are rendered in the <code>foreground</code> layer.\n    </div>\n  </div>\n</div>"
"<div style=\"line-height:1.5;\">\n"
"  <h4 style=\"margin:0 0 10px;\">ความช่วยเหลือ Typst</h4>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>วิธีการทำงานของสไตล์</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>\n"
"        ในโหมดตัวสร้างปกติ <code>fieldLabelStyle</code>, <code>fieldValueStyle</code> และ <code>sectionLabelStyle</code> จะได้รับการกำหนดค่าใน Builder และแทรกก่อน <code>typst_preamble</code> โดยอัตโนมัติ\n"
"      </li>\n"
"      <li>\n"
"        <code>typst_preamble</code> ทำงานก่อนเนื้อหาเอกสารและสามารถแทนที่สไตล์สากลได้\n"
"      </li>\n"
"      <li>\n"
"        <code>doc_header</code> กำหนด <code>header_block</code> และ <code>doc_footer</code> กำหนด <code>footer_block</code> สำหรับการตั้งค่าส่วนหัว/ส่วนท้ายของหน้า\n"
"      </li>\n"
"      <li>\n"
"        ในโหมด Raw Typst นั้น Crispy จะแทรกข้อมูลเอกสารและฟังก์ชันตัวช่วยเท่านั้น การตั้งค่าหน้า สไตล์ ส่วนหัว ส่วนท้าย และเค้าโครงอยู่ในโค้ด Raw Typst\n"
"      </li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>ตัวช่วยเหลือดิบ Typst</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>ข้อมูลเอกสารมีอยู่ในชื่อ <code>#doc.fieldname</code></li>\n"
"      <li>ใช้ <code>crispy_image(\"logo.svg\", width: 20mm)</code> และ <code>crispy_block(\"document_title-v1.0\")</code> ภายในอาร์กิวเมนต์ของฟังก์ชันหรือบริบทนิพจน์ Typst อื่นๆ</li>\n"
"      <li>เมื่อเรียกผู้ช่วยเหลือโดยตรงจากมาร์กอัป ให้เพิ่มการหลีกมาร์กอัปของ Typst: <code>#crispy_image(\"logo.svg\", width: 20mm)</code> หรือ <code>#crispy_block(\"document_title-v1.0\")</code></li>\n"
"      <li><code>crispy_image</code> แก้ไขชื่อไฟล์ธรรมดาจากเนื้อหาไฟล์ส่วนตัวของไซต์ปัจจุบันเท่านั้น</li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>ตัวอย่างด่วน</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>คำนำ: <code>#set text(font: \"Inter\", size: 11pt)</code></li>\n"
"      <li>ส่วนหัว: <code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n"
"      <li>ส่วนท้าย: <code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n"
"      <li>ตำแหน่งดิบ: <code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div>\n"
"    <strong>เลเยอร์การสร้างแบรนด์</strong>\n"
"    <div style=\"margin-top:4px;\">\n"
"      ในโหมดตัวสร้างปกติ หัวจดหมายจะแสดงผลในหน้า <code>background</code> ในขณะที่โลโก้และรหัส QR จะแสดงผลในเลเยอร์ <code>foreground</code>\n"
"    </div>\n"
"  </div>\n"
"</div>"

