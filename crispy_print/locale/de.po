msgid "1 field selected"
msgstr "1 Feld ausgewählt"

#. Content of the 'Typst Help' (HTML) field in DocType 'Crispy Format'
#: crispy_print/crispy_print/doctype/crispy_format/crispy_format.json
msgid ""
"<div style=\"line-height:1.5;\">\n"
"  <h4 style=\"margin:0 0 10px;\">Typst Help</h4>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>How Styling Works</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>\n"
"        In normal builder mode, <code>fieldLabelStyle</code>, <code>fieldValueStyle</code>, and <code>sectionLabelStyle</code> are configured in the Builder and automatically inserted before <code>typst_preamble</code>.\n"
"      </li>\n"
"      <li>\n"
"        <code>typst_preamble</code> runs before document content and can override global styles.\n"
"      </li>\n"
"      <li>\n"
"        <code>doc_header</code> defines <code>header_block</code>, and <code>doc_footer</code> defines <code>footer_block</code> for page header/footer setup.\n"
"      </li>\n"
"      <li>\n"
"        In Raw Typst mode, Crispy only injects document data and helper functions. Page setup, styling, header, footer, and layout belong in the Raw Typst code.\n"
"      </li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Raw Typst Helpers</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Document data is available as <code>#doc.fieldname</code>.</li>\n"
"      <li>Use <code>crispy_image(\"logo.svg\", width: 20mm)</code> and <code>crispy_block(\"document_title-v1.0\")</code> inside function arguments or other Typst expression contexts.</li>\n"
"      <li>When calling a helper directly from markup, add Typst's markup escape: <code>#crispy_image(\"logo.svg\", width: 20mm)</code> or <code>#crispy_block(\"document_title-v1.0\")</code>.</li>\n"
"      <li><code>crispy_image</code> resolves plain filenames only from the current site's private files assets.</li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Quick Examples</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Preamble: <code>#set text(font: \"Inter\", size: 11pt)</code></li>\n"
"      <li>Header: <code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n"
"      <li>Footer: <code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n"
"      <li>Raw placement: <code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div>\n"
"    <strong>Branding Layers</strong>\n"
"    <div style=\"margin-top:4px;\">\n"
"      In normal builder mode, the letterhead is rendered in the page <code>background</code>, while the logo and QR code are rendered in the <code>foreground</code> layer.\n"
"    </div>\n"
"  </div>\n"
"</div>"
msgstr ""
"<div style=\"line-height:1.5;\">\n"
"  <h4 style=\"margin:0 0 10px;\">Typst-Hilfe</h4>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Wie Styling funktioniert</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>\n"
"        Im normalen Builder-Modus werden <code>fieldLabelStyle</code>, <code>fieldValueStyle</code> und <code>sectionLabelStyle</code> im Builder konfiguriert und automatisch vor <code>typst_preamble</code> eingefügt.\n"
"      </li>\n"
"      <li>\n"
"        <code>typst_preamble</code> wird vor dem Dokumentinhalt ausgeführt und kann globale Stile überschreiben.\n"
"      </li>\n"
"      <li>\n"
"        <code>doc_header</code> definiert <code>header_block</code> und <code>doc_footer</code> definiert <code>footer_block</code> für die Kopf-/Fußzeileneinrichtung der Seite.\n"
"      </li>\n"
"      <li>\n"
"        Im Raw Typst-Modus fügt Crispy nur Dokumentdaten und Hilfsfunktionen ein. Seiteneinrichtung, Stil, Kopfzeile, Fußzeile und Layout gehören zum Raw Typst-Code.\n"
"      </li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Raw Typst-Helfer</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Dokumentdaten sind als <code>#doc.fieldname</code> verfügbar.</li>\n"
"      <li>Verwenden Sie <code>crispy_image(\"logo.svg\", width: 20mm)</code> und <code>crispy_block(\"document_title-v1.0\")</code> innerhalb von Funktionsargumenten oder anderen Typst-Ausdruckskontexten.</li>\n"
"      <li>Wenn Sie einen Helfer direkt aus dem Markup aufrufen, fügen Sie den Markup-Escape von Typst hinzu: <code>#crispy_image(\"logo.svg\", width: 20mm)</code> oder <code>#crispy_block(\"document_title-v1.0\")</code>.</li>\n"
"      <li><code>crispy_image</code> löst einfache Dateinamen nur aus den privaten Dateibeständen der aktuellen Site auf.</li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div style=\"margin-bottom:14px;\">\n"
"    <strong>Schnelle Beispiele</strong>\n"
"    <ol style=\"margin:6px 0 0 18px; padding:0;\">\n"
"      <li>Präambel: <code>#set text(font: \"Inter\", size: 11pt)</code></li>\n"
"      <li>Kopfzeile: <code>#let header_block = [#text(weight: 700)[#doc.doctype]]</code></li>\n"
"      <li>Fußzeile: <code>#let footer_block = [#text(size: 8pt)[#doc.name]]</code></li>\n"
"      <li>Rohplatzierung: <code>#place(top + left, crispy_image(\"logo.svg\", width: 20mm))</code></li>\n"
"    </ol>\n"
"  </div>\n"
"\n"
"  <div>\n"
"    <strong>Branding-Ebenen</strong>\n"
"    <div style=\"margin-top:4px;\">\n"
"      Im normalen Builder-Modus wird der Briefkopf in der Seite <code>background</code> gerendert, während das Logo und der QR-Code in der Ebene <code>foreground</code> gerendert werden.\n"
"    </div>\n"
"  </div>\n"
"</div>"

